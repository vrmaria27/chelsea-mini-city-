{
  "name": "chelsea-mini-city",
  "version": "0.1.0",
  "private": true,
  "description": "A cosy tabletop city-builder on a real (OpenStreetMap) map of Chelsea, for Meta Quest 3 (WebXR) with a desktop fallback.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "import:map:fetch": "node scripts/osm/fetch.mjs --out data/osm/raw.json",
    "import:map": "node scripts/osm/process.mjs data/osm/raw.json src/map/osm/chelsea-osm.json",
    "lab:trees": "esbuild src/lab/treeLab.ts --bundle --format=iife --outfile=lab/lab.js --servedir=lab"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
